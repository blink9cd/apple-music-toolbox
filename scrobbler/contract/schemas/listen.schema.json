{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://listensmith.invalid/contract/1/listen.schema.json",
  "title": "listensmith listen submission (single or import)",
  "$comment": "ListenBrainz's single and import shapes as pinned in common.schema.json, plus the ls_ keys of rulings C1, A3, A5, A8 and S2. The ListenBrainz minimum is artist, title and listened_at; this contract also requires the client and its version (C1) and seconds heard (A3).",
  "type": "object",
  "required": ["listen_type", "payload"],
  "properties": {
    "listen_type": { "enum": ["single", "import"] },
    "payload": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/listen" }
    }
  },
  "additionalProperties": false,
  "if": { "properties": { "listen_type": { "const": "single" } }, "required": ["listen_type"] },
  "then": { "properties": { "payload": { "maxItems": 1 } } },
  "$defs": {
    "listen": {
      "type": "object",
      "required": ["listened_at", "track_metadata"],
      "properties": {
        "listened_at": { "$ref": "common.schema.json#/$defs/listened_at" },
        "track_metadata": {
          "$ref": "common.schema.json#/$defs/track_metadata",
          "properties": { "additional_info": { "$ref": "#/$defs/additional_info" } }
        }
      },
      "additionalProperties": false
    },
    "additional_info": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/listenbrainz_info" },
        { "$ref": "common.schema.json#/$defs/listensmith_track" }
      ],
      "properties": {
        "ls_piece": {
          "description": "Which piece of a play split by a long pause this record is, counting from 1 (rulings A5 and S2); needs ls_play_id. Part of the repeat key (H2): an absent ls_piece reads as 1. At most 999 pieces (ruling L5).",
          "type": "integer",
          "minimum": 1,
          "maximum": 999,
          "default": 1
        }
      },
      "required": ["submission_client", "submission_client_version"],
      "anyOf": [{ "required": ["duration_played"] }, { "required": ["duration_played_ms"] }],
      "dependentRequired": { "ls_piece": ["ls_play_id"] },
      "unevaluatedProperties": false
    }
  }
}
